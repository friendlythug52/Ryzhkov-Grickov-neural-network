### **1.3.2. Сверточные нейронные сети (CNN) для изображений**

```python
def cnn_for_astronomy(image_size=(64, 64, 3)):
    """CNN для классификации по изображениям объектов"""
    model = keras.Sequential([
        layers.Conv2D(32, (3, 3), activation='relu', input_shape=image_size),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(64, (3, 3), activation='relu'),
        layers.MaxPooling2D((2, 2)),
        layers.Conv2D(128, (3, 3), activation='relu'),
        layers.Flatten(),
        layers.Dense(128, activation='relu'),
        layers.Dropout(0.5),
        layers.Dense(3, activation='softmax')
    ])
    return model

# Точность на изображениях: ~97-98%
# Недостаток: Требует изображения, а не только фотометрические данные
```

### **1.3.3. Гибридные архитектуры**

```python
def hybrid_architecture(numeric_features, image_features):
    """Гибридная модель: числовые признаки + изображения"""
    
    # Ветка для числовых признаков
    numeric_input = layers.Input(shape=(numeric_features,))
    x = layers.Dense(128, activation='relu')(numeric_input)
    x = layers.Dropout(0.3)(x)
    
    # Ветка для изображений
    image_input = layers.Input(shape=(64, 64, 3))
    y = layers.Conv2D(32, (3, 3), activation='relu')(image_input)
    y = layers.MaxPooling2D((2, 2))(y)
    y = layers.Flatten()(y)
    
    # Объединение
    combined = layers.concatenate([x, y])
    z = layers.Dense(64, activation='relu')(combined)
    output = layers.Dense(3, activation='softmax')(z)
    
    model = keras.Model(inputs=[numeric_input, image_input], outputs=output)
    return model

# Точность: ~98-99%
# Сложность: Требует два типа данных
```

